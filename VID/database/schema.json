{
  "project": "VID - Campus Management System",
  "version": "1.1.0",
  "database": "MongoDB",
  "collections": [
    {
      "name": "users",
      "description": "Central user repository with RBAC",
      "index": ["username", "email", "institution_id"],
      "schema": {
        "username": "string",
        "email": "string",
        "full_name": "string",
        "hashed_password": "string",
        "role": "enum[super-admin, admin, teacher, student, ...]",
        "institution_id": "string (nullable)",
        "is_active": "boolean",
        "created_at": "datetime",
        "updated_at": "datetime"
      }
    },
    {
      "name": "institutions",
      "description": "Multi-tenant Institution profiles",
      "index": ["name", "email"],
      "schema": {
        "name": "string",
        "address": "string",
        "phone": "string",
        "email": "string",
        "admin_user_id": "string",
        "is_active": "boolean",
        "created_at": "datetime",
        "updated_at": "datetime",
        "analytics": {
          "students_count": "integer",
          "faculty_count": "integer",
          "revenue": "float"
        }
      }
    }
  ],
  "workspaces": [
    {
      "name": "academic-coordinator",
      "features": ["Digital Notice Board", "Activities", "Principal Dashboard", "Academics", "Academic Setup", "Courses", "Master Courses", "Assessment", "Data Management", "Configurations"]
    },
    {
      "name": "admission-officer",
      "features": ["Digital Notice Board", "Prospects", "Applications", "Admissions"]
    },
    {
      "name": "common",
      "features": ["Digital Notice Board", "Student Central", "My Requests", "Payments", "Exams", "HRMS", "Configurations"]
    },
    {
      "name": "team-owner",
      "features": ["Digital Notice Board", "Institutions", "Organization Settings", "User Management", "Apps Data Management", "All Courses"]
    },
    {
      "name": "transport-coordinator",
      "features": ["Digital Notice Board", "Transport Analytics", "Transport Registrations", "Buses", "Boarding Points", "Routes", "Route Bus Assignment", "Configuration", "Transport Route"]
    },
    {
      "name": "employee",
      "features": ["Digital Notice Board", "Leaves", "Attendance", "Salary", "Expenses", "Shift Requests", "Compensatory Leave"]
    },
    {
      "name": "hostel-admin",
      "features": ["Digital Notice Board", "Hostelers", "Attendance", "Gate Pass Requests", "Reports", "Configuration"]
    },
    {
      "name": "payment-administrator",
      "features": ["Digital Notice Board", "Student Permissions", "Academic Fees", "Exam Fees", "Concessions", "Online Transactions", "Challans", "Statements", "Scholarships"]
    },
    {
      "name": "faculty",
      "features": ["Digital Notice Board", "Discussion Forum", "My Courses", "Timetable", "LMS Classrooms", "Assessments", "Attendance Tracking", "My Mentees", "Research Scholars"]
    },
    {
      "name": "student",
      "features": ["Digital Notice Board", "Attendance", "Events", "LMS", "Exams", "Assessments", "Fee Payments", "My Profile", "Calendar"]
    },
    {
      "name": "sports-officer",
      "features": ["Digital Notice Board", "Sports Events", "Team Management", "Player Registrations", "Practice Schedules", "Tournament Management", "Performance Tracking", "Reports", "Activities List", "Event Calendar", "Student Participation", "Achievements", "Certificates", "Clubs Management", "Announcements"]
    }
  ]
}
