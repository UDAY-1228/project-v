# ── VID ENVIRONMENT CONFIGURATION ──

# Database
POSTGRES_USER=vid_user
POSTGRES_PASSWORD=vid_password
POSTGRES_DB=vid_db
DATABASE_URL=postgresql+asyncpg://vid_user:vid_password@db:5432/vid_db
PRISMA_DATABASE_URL=postgresql://vid_user:vid_password@localhost:5432/vid_db

# Security
SECRET_KEY=vid-super-secret-key-12345
JWT_SECRET_KEY=vid-jwt-secret-key-67890

# Gateway
GATEWAY_PORT=5000
FLASK_ENV=development

# Services
AUTH_SERVICE_URL=http://auth-service:8001
AUTH_SERVICE_PORT=8001

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
